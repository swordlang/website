---
// Starlight's head, and the page's share card (src/pages/og).
import Default from '@astrojs/starlight/components/Head.astro';
import { card, labelOf } from '../og.mjs';

const { id, entry } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// The 404 page is not a document and has no card of its own.
const image = new URL(`${base}og/${id === '404' || !id ? 'index' : id}.png`, Astro.site).href;
const label = labelOf(id, entry.data.title);
const alt = label ? `Sword: ${label}` : 'Sword: a systems language that refuses data races.';
---

<Default />
<meta property="og:image" content={image} />
<meta property="og:image:width" content={String(card.width)} />
<meta property="og:image:height" content={String(card.height)} />
<meta property="og:image:alt" content={alt} />
